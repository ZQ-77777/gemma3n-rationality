# Copy to .env and fill in. Never commit .env.
# Use ONE block. LLM_RUN_TAG decides where data and results go:
#   data/<tag>/raw, data/<tag>/meta, results_<tag>/
# LLM_ROLE_MODE=system_as_user is required for Gemma: its chat template has no system role
# and turns must alternate user/assistant starting with user.

# --- A. Formal runs: Gemma 3n E4B served locally by vLLM in BF16 (Ampere or newer GPU, >= 24 GB) ---
#   vllm serve google/gemma-3n-E4B-it --revision <commit> --dtype bfloat16 \
#        --max-model-len 32768 --served-model-name gemma-3n-e4b-it --port 8000
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=none
LLM_MODEL=gemma-3n-e4b-it
LLM_LABEL=gemma-3n-e4b-it
LLM_RUN_TAG=gemma3n-e4b
LLM_ROLE_MODE=system_as_user
LLM_PROMPTS=paper

# --- B. Debugging only: quantized gemma3n:e4b through Ollama (laptop or free Colab T4) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gemma3n:e4b
# LLM_LABEL=gemma-3n-e4b-it (debug)
# LLM_RUN_TAG=gemma3n-debug
# LLM_ROLE_MODE=system_as_user
# LLM_PROMPTS=paper
